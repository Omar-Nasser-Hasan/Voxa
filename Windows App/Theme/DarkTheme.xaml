<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Brand accent stays identical to Light so the app still reads as "Voxa" -->
    <Color x:Key="Color.Accent">#7C6EF0</Color>
    <Color x:Key="Color.AccentAlt">#C071E8</Color>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentAlt" Color="{StaticResource Color.AccentAlt}" />
    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color.Accent}" Offset="0" />
        <GradientStop Color="{StaticResource Color.AccentAlt}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#332C4A" />
    <SolidColorBrush x:Key="Brush.AccentSoftHover" Color="#3D3459" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFFFFF" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Brush.Background" Color="#17151F" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#1F1C2B" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#252134" />
    <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="#14121C" />

    <!-- Borders / dividers -->
    <SolidColorBrush x:Key="Brush.Border" Color="#332F45" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#443F5C" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#2B2739" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F1EFFA" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A6A1C2" />
    <SolidColorBrush x:Key="Brush.TextHint" Color="#8A85A8" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#5C5876" />

    <!-- Controls -->
    <SolidColorBrush x:Key="Brush.ControlBackground" Color="#252134" />
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#3B3651" />
    <SolidColorBrush x:Key="Brush.ControlBorderHover" Color="#7C6EF0" />
    <SolidColorBrush x:Key="Brush.SliderTrack" Color="#332F45" />
    <SolidColorBrush x:Key="Brush.SwitchOff" Color="#3B3651" />

    <!-- Semantic -->
    <SolidColorBrush x:Key="Brush.Success" Color="#4CC26D" />
    <SolidColorBrush x:Key="Brush.Error" Color="#F0685D" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#1E3327" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#E0B84C" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#3A331A" />

    <!-- Shadow -->
    <Color x:Key="Color.CardShadow">#66000000</Color>

    <sys:Boolean x:Key="Theme.IsDark">True</sys:Boolean>

</ResourceDictionary>
