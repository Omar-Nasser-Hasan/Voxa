<Window x:Class="Voxa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Voxa.Controls"
        xmlns:conv="clr-namespace:Voxa.Converters"
        xmlns:loc="clr-namespace:Voxa.Services"
        Title="Voxa"
        Height="820" Width="1200" MinHeight="700" MinWidth="1040"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Closing="Window_Closing"
        FontFamily="Segoe UI"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationService.Instance}}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        Background="{DynamicResource Brush.Background}">

    <Window.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColorConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <conv:PeakToHeightConverter x:Key="PeakToHeightConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,0,4,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="13" Margin="0,0,14,0">
                <Border.Background>
                    <ImageBrush ImageSource="Assets/voxa-mark.png" Stretch="Uniform" />
                </Border.Background>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Voxa" Style="{StaticResource HeaderText}" />
                <TextBlock Text="{Binding [App.Tagline], Source={x:Static loc:LocalizationService.Instance}}"
                           Style="{StaticResource SubHeaderText}" Margin="0,1,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding AppVersionText}" FontSize="11" Margin="0,0,10,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                <Button Content="{Binding [Language.Toggle], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource SecondaryButton}"
                        Click="LanguageToggle_Click" Margin="0,0,8,0" />
                <Button x:Name="ThemeToggleButton" Style="{StaticResource IconToggleButton}"
                        Click="ThemeToggle_Click" ToolTip="{Binding [Theme.Toggle], Source={x:Static loc:LocalizationService.Instance}}"
                        VerticalAlignment="Center" Content="&#127769;" />
            </StackPanel>
        </Grid>

        <!-- Banners: update available, then batch-complete -->
        <StackPanel Grid.Row="1">

            <!-- Update-available banner -->
            <Border Style="{StaticResource Card}" Margin="4,0,4,16" Padding="16,14"
                    Visibility="{Binding ShowUpdateBanner, Converter={StaticResource BoolToVis}}">
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource Color.Accent}" />
                </Border.BorderBrush>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Margin="0,0,12,0"
                            Background="{DynamicResource Brush.AccentSoft}">
                        <TextBlock Text="&#8593;" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Update.Available], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="{Binding UpdateBannerText}" Style="{StaticResource SubHeaderText}"
                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="{Binding [View], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource SecondaryButton}"
                            Margin="12,0,8,0" Command="{Binding OpenUpdatePageCommand}" />
                    <Button Grid.Column="3" Content="{Binding [Dismiss], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding DismissUpdateBannerCommand}" />
                </Grid>
            </Border>

            <!-- Batch-complete banner -->
            <Border Style="{StaticResource Card}" Margin="4,0,4,16" Padding="16,14"
                    Visibility="{Binding ShowCompletionBanner, Converter={StaticResource BoolToVis}}">
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource Color.Accent}" />
                </Border.BorderBrush>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Margin="0,0,12,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CompletionHasFailures}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="&#10003;" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.Success}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Batch.Complete], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="{Binding CompletionSummary}" Style="{StaticResource SubHeaderText}"
                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="{Binding [Dismiss], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource SecondaryButton}"
                            Margin="12,0,0,0" Command="{Binding DismissCompletionCommand}" />
                </Grid>
            </Border>

        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <!-- Left: file queue -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="4,0,0,0" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [Files], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource CardHeaderText}" Margin="0" />
                        <TextBlock Grid.Column="1" Text="{Binding QueueCountText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextHint}" VerticalAlignment="Center" />
                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,14"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}">
                        <Button Content="{Binding [AddFiles], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource SecondaryButton}" Command="{Binding AddFilesCommand}" />
                        <Button Content="{Binding [AddFolder], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource SecondaryButton}" Command="{Binding AddFolderCommand}" />
                        <Button Content="{Binding [RemoveSelected], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource SecondaryButton}" Click="RemoveSelected_Click" />
                        <Button Content="{Binding [ClearAll], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource SecondaryButton}" Command="{Binding ClearFilesCommand}" />
                    </WrapPanel>

                    <Border Grid.Row="2" Background="{DynamicResource Brush.SurfaceSunken}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasNoFiles, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#127925;" FontSize="28" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextDisabled}" />
                                <TextBlock Text="{Binding [DropFiles], Source={x:Static loc:LocalizationService.Instance}}"
                                           HorizontalAlignment="Center" FontSize="13" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Brush.TextHint}" />
                            </StackPanel>

                            <ListView x:Name="FilesListView" ItemsSource="{Binding Files}"
                                      SelectedItem="{Binding SelectedFile}"
                                      Margin="8" SelectionMode="Extended">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="" Width="26">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="&#9888;" FontSize="13"
                                                               Foreground="{DynamicResource Brush.Warning}"
                                                               ToolTip="{Binding QualityWarningMessage}"
                                                               Visibility="{Binding HasQualityWarning, Converter={StaticResource BoolToVis}}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{Binding [Column.File], Source={x:Static loc:LocalizationService.Instance}}" Width="230">
                                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FileName}" FlowDirection="LeftToRight" TextAlignment="Left" /></DataTemplate></GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{Binding [Column.Status], Source={x:Static loc:LocalizationService.Instance}}" Width="110">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StatusDisplay}"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                               FontWeight="SemiBold" FontSize="12" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{Binding [Column.Details], Source={x:Static loc:LocalizationService.Instance}}" Width="230">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StatusMessage}"
                                                               ToolTip="{Binding StatusMessage}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="{Binding [Column.Progress], Source={x:Static loc:LocalizationService.Instance}}" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ProgressBar Width="70" Height="8" Minimum="0" Maximum="100"
                                                                 Value="{Binding Progress, Mode=OneWay}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Waveform preview: shows the currently-selected file -->
                    <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,10" CornerRadius="10"
                            Background="{DynamicResource Brush.SurfaceSunken}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            Visibility="{Binding HasSelectedFile, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding PreviewSourceLabel}" FontSize="11"
                                               Foreground="{DynamicResource Brush.TextHint}" />
                                    <TextBlock Text="{Binding SelectedPreviewDisplayName}" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                </StackPanel>

                                <CheckBox Grid.Column="1" Content="{Binding [Preview.Output], Source={x:Static loc:LocalizationService.Instance}}" Margin="12,0,12,0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding PreviewOutput}"
                                          IsEnabled="{Binding CanPreviewOutput}" />

                                <TextBlock Grid.Column="2" Text="{Binding [Preview.Loading], Source={x:Static loc:LocalizationService.Instance}}" FontSize="12" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextHint}"
                                           Visibility="{Binding IsWaveformLoading, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Width="72" Content="{Binding PlayPauseButtonText}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,7"
                                        Command="{Binding TogglePlaybackCommand}" />

                                <TextBlock Grid.Column="1" Text="{Binding PlaybackTimeText}"
                                           FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />

                                <Border x:Name="WaveformViewport" Grid.Column="2" Height="64"
                                        Background="Transparent" ClipToBounds="True" Cursor="Hand"
                                        MouseLeftButtonDown="WaveformViewport_MouseLeftButtonDown"
                                        MouseMove="WaveformViewport_MouseMove"
                                        MouseLeftButtonUp="WaveformViewport_MouseLeftButtonUp">
                                    <controls:WaveformView Peaks="{Binding WaveformPeaks}"
                                                           Progress="{Binding PlaybackProgress}"
                                                           PlayedBrush="{DynamicResource Brush.Accent}"
                                                           UnplayedBrush="{DynamicResource Brush.TextDisabled}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: parameters, presets, output -->
            <Border Grid.Column="2" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="16" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="2">
                    <StackPanel IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}">

                    <Border Style="{StaticResource InspectorCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding [OutputFormat.Title], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource CardHeaderText}" />
                            <ComboBox ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding OutputFormat}" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="{Binding [OutputFormat.Hint], Source={x:Static loc:LocalizationService.Instance}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InspectorCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding [SampleRate.Title], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource CardHeaderText}" />
                            <CheckBox Content="{Binding [SampleRate.Keep], Source={x:Static loc:LocalizationService.Instance}}"
                                      IsChecked="{Binding KeepOriginalSampleRate}" Margin="0,0,0,10" />
                            <ComboBox ItemsSource="{Binding CommonSampleRates}"
                                      Text="{Binding SampleRateHz, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      IsEnabled="{Binding KeepOriginalSampleRate, Converter={StaticResource InverseBooleanConverter}}" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="{Binding [SampleRate.Hint], Source={x:Static loc:LocalizationService.Instance}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InspectorCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding [Volume.Title], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource CardHeaderText}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="55" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="-30" Maximum="30" Value="{Binding VolumeChangeDb}"
                                        TickFrequency="5" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding VolumeChangeDb, StringFormat={}{0:0.#} dB}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="{Binding [Volume.Hint], Source={x:Static loc:LocalizationService.Instance}}" />
                            <CheckBox Content="{Binding [Volume.Normalize], Source={x:Static loc:LocalizationService.Instance}}"
                                      IsChecked="{Binding NormalizeVolume}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InspectorCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding [Clarity.Title], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource CardHeaderText}" />
                            <CheckBox Content="{Binding [Clarity.Enable], Source={x:Static loc:LocalizationService.Instance}}"
                                      IsChecked="{Binding EnhanceClarity}" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="{Binding [Clarity.Hint], Source={x:Static loc:LocalizationService.Instance}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InspectorCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding [Speed.Title], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource CardHeaderText}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="55" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="0.5" Maximum="2.0" Value="{Binding SpeedMultiplier}"
                                        TickFrequency="0.25" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SpeedMultiplier, StringFormat={}{0:0.00}x}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="{Binding [Speed.Hint], Source={x:Static loc:LocalizationService.Instance}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InspectorCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding [Silence.Title], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource CardHeaderText}" />
                            <CheckBox Content="{Binding [Silence.Trim], Source={x:Static loc:LocalizationService.Instance}}" IsChecked="{Binding TrimSilence}" />
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding [Silence.TrimHint], Source={x:Static loc:LocalizationService.Instance}}" Margin="0,0,0,12" />
                            <TextBlock Text="{Binding [Silence.Padding], Source={x:Static loc:LocalizationService.Instance}}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="55" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="0" Maximum="10" Value="{Binding SilencePaddingStartSec}"
                                        TickFrequency="1" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SilencePaddingStartSec, StringFormat={}{0:0.#}s}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="{Binding [Silence.StartHint], Source={x:Static loc:LocalizationService.Instance}}" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="55" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="0" Maximum="10" Value="{Binding SilencePaddingEndSec}"
                                        TickFrequency="1" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SilencePaddingEndSec, StringFormat={}{0:0.#}s}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="{Binding [Silence.EndHint], Source={x:Static loc:LocalizationService.Instance}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InspectorCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding [Names.Title], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource CardHeaderText}" />
                            <CheckBox Content="{Binding [Names.Enable], Source={x:Static loc:LocalizationService.Instance}}"
                                      IsChecked="{Binding UseCustomFileNames}" Margin="0,0,0,10" />
                            <TextBox Text="{Binding FileNamePattern, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                                     IsEnabled="{Binding UseCustomFileNames}"
                                     Margin="0,0,0,8" VerticalContentAlignment="Center" />
                            <Grid Margin="0,0,0,8" IsEnabled="{Binding UseCustomFileNames}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding [Names.Start], Source={x:Static loc:LocalizationService.Instance}}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" />
                                <TextBox Grid.Column="1" Text="{Binding SequenceStart, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                                         Margin="8,0,0,0" VerticalContentAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding FileNamePatternPreview}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"
                                       Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="{Binding [Names.Hint], Source={x:Static loc:LocalizationService.Instance}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InspectorCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding [Metadata.Title], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource CardHeaderText}" />
                            <CheckBox Content="{Binding [Metadata.Enable], Source={x:Static loc:LocalizationService.Instance}}" IsChecked="{Binding WriteMetadata}" Margin="0,0,0,10" />
                            <Grid IsEnabled="{Binding WriteMetadata}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{Binding [Metadata.TitleLabel], Source={x:Static loc:LocalizationService.Instance}}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MetadataTitle, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1" Text="{Binding [Metadata.Artist], Source={x:Static loc:LocalizationService.Instance}}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MetadataArtist, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="2" Text="{Binding [Metadata.Album], Source={x:Static loc:LocalizationService.Instance}}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MetadataAlbum, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}" Text="{Binding [Metadata.Hint], Source={x:Static loc:LocalizationService.Instance}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InspectorCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding [Presets.Title], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource CardHeaderText}" />
                            <ComboBox ItemsSource="{Binding Presets}" DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedPreset}" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox Width="150" Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding [Presets.Name], Source={x:Static loc:LocalizationService.Instance}}" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                                <Button Content="{Binding [Presets.Save], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource SecondaryButton}" Command="{Binding SavePresetCommand}" />
                            </StackPanel>
                            <Button Content="{Binding [Presets.Delete], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Command="{Binding DeletePresetCommand}" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="{Binding [Presets.Hint], Source={x:Static loc:LocalizationService.Instance}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding [OutputFolder.Title], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource CardHeaderText}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="150" IsReadOnly="True" Text="{Binding OutputFolder, Mode=OneWay}" FlowDirection="LeftToRight"
                                         Margin="0,0,8,0" VerticalContentAlignment="Center" />
                                <Button Content="{Binding [Browse], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseOutputFolderCommand}" />
                                <Button Content="{Binding [Open], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource SecondaryButton}" Click="OpenOutputFolder_Click" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="{Binding [OutputFolder.Hint], Source={x:Static loc:LocalizationService.Instance}}" />
                        </StackPanel>
                    </Border>

                    <!-- Batch history: a running log of past runs so the user can check back later
                         on whether a batch actually finished and how many files failed. -->
                    <Border Style="{StaticResource InspectorCard}" Margin="0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding [History.Title], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource CardHeaderText}" Margin="0" />
                                <Button Grid.Column="1" Content="{Binding [Clear], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource SecondaryButton}"
                                        Padding="10,5" Command="{Binding ClearHistoryCommand}" />
                            </Grid>

                            <TextBlock Text="{Binding [History.Empty], Source={x:Static loc:LocalizationService.Instance}}"
                                       Style="{StaticResource HintText}" Margin="0"
                                       Visibility="{Binding HasNoBatchHistory, Converter={StaticResource BoolToVis}}" />

                            <ItemsControl ItemsSource="{Binding BatchHistory}" MaxHeight="260">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Brush.SurfaceSunken}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding StartedAtUtc, StringFormat={}{0:MMM d, h:mm tt}}"
                                                               FontWeight="SemiBold" FontSize="12"
                                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding OutputFormat}"
                                                               FontSize="11" Foreground="{DynamicResource Brush.TextHint}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer: progress + start/cancel -->
        <Border Grid.Row="3" Style="{StaticResource CommandBar}" Margin="4,18,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0" Height="10" Minimum="0" Maximum="100"
                             Margin="0,0,16,0" VerticalAlignment="Center"
                             Value="{Binding OverallProgress, Mode=OneWay}" />

                <Button Grid.Column="1" Content="{Binding [Cancel], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Padding="16,11"
                        VerticalAlignment="Center"
                        Command="{Binding CancelProcessingCommand}"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" />

                <Button Grid.Column="2" Content="{Binding [StartProcessing], Source={x:Static loc:LocalizationService.Instance}}" Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center" MinWidth="176" Height="44"
                        Command="{Binding StartProcessingCommand}" />

            </Grid>
        </Border>

    </Grid>
</Window>
