<Window x:Class="Voxa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Voxa.Controls"
        xmlns:conv="clr-namespace:Voxa.Converters"
        Title="Voxa"
        Height="780" Width="1120" MinHeight="660" MinWidth="960"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        Closing="Window_Closing"
        FontFamily="Segoe UI"
        Background="{DynamicResource Brush.Background}">

    <Window.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColorConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <conv:PeakToHeightConverter x:Key="PeakToHeightConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,0,4,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0">
                <Border.Background>
                    <ImageBrush ImageSource="Assets/voxa-mark.png" Stretch="Uniform" />
                </Border.Background>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Voxa" Style="{StaticResource HeaderText}" />
                <TextBlock Text="Convert, resample, adjust volume and speed, and clean up audio - in bulk."
                           Style="{StaticResource SubHeaderText}" Margin="0,1,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding AppVersionText}" FontSize="11" Margin="0,0,10,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                <Button x:Name="ThemeToggleButton" Style="{StaticResource IconToggleButton}"
                        Click="ThemeToggle_Click" ToolTip="Switch between light and dark"
                        VerticalAlignment="Center" Content="&#127769;" />
            </StackPanel>
        </Grid>

        <!-- Banners: update available, then batch-complete -->
        <StackPanel Grid.Row="1">

            <!-- Update-available banner -->
            <Border Style="{StaticResource Card}" Margin="4,0,4,16" Padding="16,14"
                    Visibility="{Binding ShowUpdateBanner, Converter={StaticResource BoolToVis}}">
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource Color.Accent}" />
                </Border.BorderBrush>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Margin="0,0,12,0"
                            Background="{DynamicResource Brush.AccentSoft}">
                        <TextBlock Text="&#8593;" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Update available" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="{Binding UpdateBannerText}" Style="{StaticResource SubHeaderText}"
                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="View" Style="{StaticResource SecondaryButton}"
                            Margin="12,0,8,0" Command="{Binding OpenUpdatePageCommand}" />
                    <Button Grid.Column="3" Content="Dismiss" Style="{StaticResource SecondaryButton}"
                            Command="{Binding DismissUpdateBannerCommand}" />
                </Grid>
            </Border>

            <!-- Batch-complete banner -->
            <Border Style="{StaticResource Card}" Margin="4,0,4,16" Padding="16,14"
                    Visibility="{Binding ShowCompletionBanner, Converter={StaticResource BoolToVis}}">
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource Color.Accent}" />
                </Border.BorderBrush>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Margin="0,0,12,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CompletionHasFailures}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="&#10003;" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.Success}" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Batch complete" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="{Binding CompletionSummary}" Style="{StaticResource SubHeaderText}"
                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="Dismiss" Style="{StaticResource SecondaryButton}"
                            Margin="12,0,0,0" Command="{Binding DismissCompletionCommand}" />
                </Grid>
            </Border>

        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Left: file queue -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="4,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Files" Style="{StaticResource CardHeaderText}" Margin="0,0,0,10" />

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}">
                        <Button Content="Add Files..." Style="{StaticResource SecondaryButton}" Command="{Binding AddFilesCommand}" />
                        <Button Content="Add Folder..." Style="{StaticResource SecondaryButton}" Command="{Binding AddFolderCommand}" />
                        <Button Content="Remove Selected" Style="{StaticResource SecondaryButton}" Click="RemoveSelected_Click" />
                        <Button Content="Clear All" Style="{StaticResource SecondaryButton}" Command="{Binding ClearFilesCommand}" />
                    </StackPanel>

                    <Border Grid.Row="2" Background="{DynamicResource Brush.SurfaceSunken}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasNoFiles, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#127925;" FontSize="28" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextDisabled}" />
                                <TextBlock Text="Drag and drop audio files or folders here"
                                           HorizontalAlignment="Center" FontSize="13" Margin="0,8,0,0"
                                           Foreground="{DynamicResource Brush.TextHint}" />
                            </StackPanel>

                            <ListView x:Name="FilesListView" ItemsSource="{Binding Files}"
                                      SelectedItem="{Binding SelectedFile}"
                                      Margin="8" SelectionMode="Extended">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="" Width="26">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="&#9888;" FontSize="13"
                                                               Foreground="{DynamicResource Brush.Warning}"
                                                               ToolTip="{Binding QualityWarningMessage}"
                                                               Visibility="{Binding HasQualityWarning, Converter={StaticResource BoolToVis}}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="File" Width="230" DisplayMemberBinding="{Binding FileName}" />
                                        <GridViewColumn Header="Status" Width="110">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StatusDisplay}"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                               FontWeight="SemiBold" FontSize="12" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Details" Width="230">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StatusMessage}"
                                                               ToolTip="{Binding StatusMessage}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Progress" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ProgressBar Width="70" Height="8" Minimum="0" Maximum="100"
                                                                 Value="{Binding Progress, Mode=OneWay}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Waveform preview: shows the currently-selected file -->
                    <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,10" CornerRadius="10"
                            Background="{DynamicResource Brush.SurfaceSunken}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            Visibility="{Binding HasSelectedFile, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding PreviewSourceLabel}" FontSize="11"
                                               Foreground="{DynamicResource Brush.TextHint}" />
                                    <TextBlock Text="{Binding SelectedPreviewDisplayName}" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                </StackPanel>

                                <CheckBox Grid.Column="1" Content="Output" Margin="12,0,12,0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding PreviewOutput}"
                                          IsEnabled="{Binding CanPreviewOutput}" />

                                <TextBlock Grid.Column="2" Text="Loading waveform..." FontSize="12" HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextHint}"
                                           Visibility="{Binding IsWaveformLoading, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Width="72" Content="{Binding PlayPauseButtonText}"
                                        Style="{StaticResource SecondaryButton}" Padding="10,7"
                                        Command="{Binding TogglePlaybackCommand}" />

                                <TextBlock Grid.Column="1" Text="{Binding PlaybackTimeText}"
                                           FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />

                                <Border x:Name="WaveformViewport" Grid.Column="2" Height="64"
                                        Background="Transparent" ClipToBounds="True" Cursor="Hand"
                                        MouseLeftButtonDown="WaveformViewport_MouseLeftButtonDown"
                                        MouseMove="WaveformViewport_MouseMove"
                                        MouseLeftButtonUp="WaveformViewport_MouseLeftButtonUp">
                                    <controls:WaveformView Peaks="{Binding WaveformPeaks}"
                                                           Progress="{Binding PlaybackProgress}"
                                                           PlayedBrush="{DynamicResource Brush.Accent}"
                                                           UnplayedBrush="{DynamicResource Brush.TextDisabled}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: parameters, presets, output -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
                <StackPanel IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Output format" Style="{StaticResource CardHeaderText}" />
                            <ComboBox ItemsSource="{Binding AvailableFormats}" SelectedItem="{Binding OutputFormat}" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="The file type every processed audio file will be saved as." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Sample rate" Style="{StaticResource CardHeaderText}" />
                            <CheckBox Content="Keep each file's original sample rate"
                                      IsChecked="{Binding KeepOriginalSampleRate}" Margin="0,0,0,10" />
                            <ComboBox ItemsSource="{Binding CommonSampleRates}"
                                      Text="{Binding SampleRateHz, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      IsEnabled="{Binding KeepOriginalSampleRate, Converter={StaticResource InverseBooleanConverter}}" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="How many times per second audio is measured, in Hz. Higher is clearer but larger; 44100 or 48000 Hz is standard, 16000 Hz is common for speech/transcription." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Volume" Style="{StaticResource CardHeaderText}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="55" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="-30" Maximum="30" Value="{Binding VolumeChangeDb}"
                                        TickFrequency="5" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding VolumeChangeDb, StringFormat={}{0:0.#} dB}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Make files quieter or louder. 0 dB leaves volume unchanged." />
                            <CheckBox Content="Normalize loudness (even out volume across files)"
                                      IsChecked="{Binding NormalizeVolume}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Clarity" Style="{StaticResource CardHeaderText}" />
                            <CheckBox Content="Enhance clarity (reduce background noise, boost speech presence)"
                                      IsChecked="{Binding EnhanceClarity}" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Good for recordings with hiss, hum, or muffled speech." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Playback speed" Style="{StaticResource CardHeaderText}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="55" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="0.5" Maximum="2.0" Value="{Binding SpeedMultiplier}"
                                        TickFrequency="0.25" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SpeedMultiplier, StringFormat={}{0:0.00}x}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="1.00x is normal speed. Below 1 is slower, above 1 is faster. Pitch stays natural." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Silence padding" Style="{StaticResource CardHeaderText}" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="55" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="0" Maximum="10" Value="{Binding SilencePaddingStartSec}"
                                        TickFrequency="1" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SilencePaddingStartSec, StringFormat={}{0:0.#}s}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Adds quiet at the very start of each file. 0 means no lead-in." Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="55" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="0" Maximum="10" Value="{Binding SilencePaddingEndSec}"
                                        TickFrequency="1" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SilencePaddingEndSec, StringFormat={}{0:0.#}s}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Adds quiet at the very end of each file. Handy for podcast hosts or voicemail systems that want a beat before/after your voice." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Output file names" Style="{StaticResource CardHeaderText}" />
                            <CheckBox Content="Use custom output file names"
                                      IsChecked="{Binding UseCustomFileNames}" Margin="0,0,0,10" />
                            <TextBox Text="{Binding FileNamePattern, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding UseCustomFileNames}"
                                     Margin="0,0,0,8" VerticalContentAlignment="Center" />
                            <Grid Margin="0,0,0,8" IsEnabled="{Binding UseCustomFileNames}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Start numbering at" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12" />
                                <TextBox Grid.Column="1" Text="{Binding SequenceStart, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="8,0,0,0" VerticalContentAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding FileNamePatternPreview, StringFormat=Preview: {0}}"
                                       FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"
                                       Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Use {name} for the original file name and {n}, {n2}, {n3}, or {n4} for a sequence number (e.g. 001). Example: Interview_{n3} becomes Interview_001, Interview_002, and so on." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Presets" Style="{StaticResource CardHeaderText}" />
                            <ComboBox ItemsSource="{Binding Presets}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedPreset}" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox Width="150" Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Name for a new preset" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                                <Button Content="Save Preset" Style="{StaticResource SecondaryButton}" Command="{Binding SavePresetCommand}" />
                            </StackPanel>
                            <Button Content="Delete Selected Preset" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left" Command="{Binding DeletePresetCommand}" />
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Save your current settings to reuse them next time, e.g. 'Podcast format' or 'Transcription standard'." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Output folder" Style="{StaticResource CardHeaderText}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="150" IsReadOnly="True" Text="{Binding OutputFolder, Mode=OneWay}"
                                         Margin="0,0,8,0" VerticalContentAlignment="Center" />
                                <Button Content="Browse..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowseOutputFolderCommand}" />
                                <Button Content="Open" Style="{StaticResource SecondaryButton}" Click="OpenOutputFolder_Click" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="Processed files are saved here. Your original files are never changed or moved." />
                        </StackPanel>
                    </Border>

                    <!-- Batch history: a running log of past runs so the user can check back later
                         on whether a batch actually finished and how many files failed. -->
                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Batch history" Style="{StaticResource CardHeaderText}" Margin="0" />
                                <Button Grid.Column="1" Content="Clear" Style="{StaticResource SecondaryButton}"
                                        Padding="10,5" Command="{Binding ClearHistoryCommand}" />
                            </Grid>

                            <TextBlock Text="No batches finished yet in this session or a previous one."
                                       Style="{StaticResource HintText}" Margin="0"
                                       Visibility="{Binding HasNoBatchHistory, Converter={StaticResource BoolToVis}}" />

                            <ItemsControl ItemsSource="{Binding BatchHistory}" MaxHeight="260">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Brush.SurfaceSunken}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding StartedAtUtc, StringFormat={}{0:MMM d, h:mm tt}}"
                                                               FontWeight="SemiBold" FontSize="12"
                                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding OutputFormat}"
                                                               FontSize="11" Foreground="{DynamicResource Brush.TextHint}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,3,0,0"
                                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer: progress + start/cancel -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="4,16,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ProgressBar Height="14" Minimum="0" Maximum="100" Value="{Binding OverallProgress, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <TextBlock Text="{Binding EtaText}" FontSize="12" Margin="12,0,0,0"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0" Padding="16,11"
                        Command="{Binding CancelProcessingCommand}"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" />

                <Button Grid.Column="2" Content="Start Processing" Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartProcessingCommand}" />
            </Grid>
        </Border>

    </Grid>
</Window>
