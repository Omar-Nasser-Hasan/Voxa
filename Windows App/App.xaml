<Application x:Class="Voxa.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      No StartupUri here on purpose: App.xaml.cs opens SetupWindow first (which checks for /
      downloads FFmpeg if needed) and only opens MainWindow once that's confirmed ready.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the "active theme" - ThemeService swaps this entry at runtime
                     to flip between Light and Dark. Keep it first. -->
                <ResourceDictionary Source="Theme/LightTheme.xaml" />
                <ResourceDictionary Source="Controls/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
