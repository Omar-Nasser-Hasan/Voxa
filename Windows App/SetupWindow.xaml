<Window x:Class="Voxa.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voxa"
        Height="320" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        FontFamily="Segoe UI"
        Background="{DynamicResource Brush.Background}"
        ShowInTaskbar="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20" HorizontalAlignment="Center">
            <Border Width="48" Height="48" CornerRadius="12" HorizontalAlignment="Center">
                <Border.Background>
                    <ImageBrush ImageSource="Assets/voxa-mark.png" Stretch="Uniform" />
                </Border.Background>
            </Border>
            <TextBlock Text="Voxa" FontSize="20" FontWeight="Bold" Margin="0,10,0,0"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Setting things up for the first time..." Margin="0,4,0,0"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Middle: either the progress panel or the error panel -->
        <Grid Grid.Row="1" VerticalAlignment="Center">

            <!-- Progress panel -->
            <StackPanel Visibility="{Binding IsSettingUp, Converter={StaticResource BoolToVis}}">
                <ProgressBar Height="12" Minimum="0" Maximum="100"
                             Value="{Binding Percent, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate}" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           HorizontalAlignment="Center" Margin="0,12,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}"
                        HorizontalAlignment="Center" Margin="0,18,0,0" />
            </StackPanel>

            <!-- Error panel -->
            <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Setup couldn't finish" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource Brush.Error}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Content="Try Again" Style="{StaticResource PrimaryButton}"
                            Command="{Binding RetryCommand}" Margin="0,0,8,0" />
                    <Button Content="Quit" Style="{StaticResource SecondaryButton}"
                            Command="{Binding QuitCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Footer note -->
        <TextBlock Grid.Row="2" Text="This only happens once - the app will open instantly next time."
                    Foreground="{DynamicResource Brush.TextHint}" FontSize="11" HorizontalAlignment="Center"
                    Visibility="{Binding IsSettingUp, Converter={StaticResource BoolToVis}}" />
    </Grid>
</Window>
